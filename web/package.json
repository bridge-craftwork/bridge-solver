{
  "name": "bridge-solver-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Double-dummy analysis in the browser: paste a PBN, a LIN file or a BBO handviewer URL",
  "scripts": {
    "wasm": "wasm-pack build ../wasm --release --target web --out-dir ../web/src/wasm --no-typescript",
    "dev": "npm run wasm && vite",
    "build": "vite build",
    "build:all": "npm run wasm && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
